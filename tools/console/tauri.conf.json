{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSBU Console",
  "version": "0.1.0",
  "identifier": "dev.ssbu-recomp.console",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SSBU Console",
        "width": 1200,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
